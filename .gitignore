# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# The Studio is built into the package so `cacophony serve` can serve it.
# It is an artifact of `npm run build`, not source.
backend/cacophony/api/static/

# ---- Cacophony runtime state ----
# Generated datasets and assets must never be committed.
#
# Anchored with a leading slash, deliberately. An unanchored directory pattern
# matches at every depth, and `runs/` therefore also matched
# `backend/cacophony/runs/` - the Conductor - which went uncommitted from
# Phase 3 until it was noticed in Phase 10. A fresh clone could not import
# `cacophony.runs`. Generated output lives in a directory the user names with
# `-d`, so anchoring loses nothing and the trap is worth closing for good.
/out/
/output/
/runs/
/generated/
out/*/
output/*/
.cacophony/
*.cacophony-run
assets/generated/

# Local metadata database (SQLite) - see CACOPHONY.md section 42
*.db
*.sqlite
*.sqlite3

# ---- Secrets (see CACOPHONY.md section 63) ----
.env
.env.*
!.env.example
secrets.toml
*.key
*.pem

# ---- Desktop build (design document section 41) ----
# The Rust target directory and the frozen backend are build output, not source.
# Anchored, like the runtime-state patterns above and for the same reason.
/desktop/src-tauri/target/
/desktop/src-tauri/binaries/
/desktop/src-tauri/gen/
/desktop/.build/

# ---- Editors / OS ----
# Contents rather than the directory itself: git cannot re-include a file whose
# parent directory is excluded, and one file here is worth sharing.
.vscode/*
# ...the watcher exclusions, which every clone of this repository wants:
# `desktop/src-tauri/target` is 4.5 GB after a build, VS Code's file watcher
# ignores .gitignore, and the result is an editor the kernel eventually kills.
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
